# Optional. The Go backend will default to ~/.kube/config when unset.
# KUBECONFIG=

# Optional. Override the kubeconfig context namespace.
# AGENT_SANDBOX_NAMESPACE=

# Optional. Frontend HTTP/WS base. Defaults to http://127.0.0.1:8787
# VITE_API_BASE=http://127.0.0.1:8787

# Set to true to use the in-browser mock instead of the Go backend.
# VITE_USE_MOCK=true
